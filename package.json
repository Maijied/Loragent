{
  "name": "loragent",
  "displayName": "Loragent — Universal Multi-Agent Ecosystem",
  "version": "2.0.0",
  "description": "224-agent virtual software firm for Lorapok Labs — Hub-and-Spoke topology, 6 squad formations, TiTi Vault zero-trust enclave, MCP lazy-loading, and autonomous multi-agent orchestration.",
  "publisher": "LorapokLabs",
  "license": "MIT",
  "icon": "media/icon.png",
  "author": {
    "name": "Maizied",
    "url": "https://lorapok.github.io"
  },
  "homepage": "https://loragent.lorapok.tech",
  "repository": {
    "type": "git",
    "url": "https://github.com/Maijied/Loragent"
  },
  "engines": {
    "node": ">=20.0.0",
    "vscode": "^1.93.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "lorapok",
    "loragent",
    "agents",
    "skills",
    "mcp",
    "orchestration",
    "multi-agent",
    "titi-vault",
    "image-generation",
    "deployment",
    "development",
    "automation"
  ],
  "contributors": [
    {
      "name": "Lorapok Labs",
      "email": "lorapokdev@gmail.com",
      "url": "https://lorapok.tech"
    }
  ],
  "company": {
    "name": "Lorapok Labs",
    "email": "lorapokdev@gmail.com",
    "supportEmail": "support@lorapok.tech",
    "website": "https://lorapok.tech",
    "adminUrl": "https://mission-control.lorapok.tech"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./src/extension.js",
  "types": "./sdk/index.d.ts",
  "exports": {
    ".": {
      "types": "./sdk/index.d.ts",
      "import": "./sdk/index.js",
      "default": "./sdk/index.js"
    },
    "./sdk": {
      "types": "./sdk/index.d.ts",
      "import": "./sdk/index.js",
      "default": "./sdk/index.js"
    },
    "./cli": "./face/cli/index.js",
    "./mcp": "./port/mcp/server.js"
  },
  "bin": {
    "install-officers": "./bin/install-officers.js",
    "loragent-mcp": "./port/mcp/server.js",
    "loragent": "./face/cli/index.js"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "loragent.boss",
        "title": "Loragent: Summon Boss Orchestrator",
        "category": "Loragent"
      },
      {
        "command": "loragent.formations",
        "title": "Loragent: Select Squad Formation Matrix",
        "category": "Loragent"
      },
      {
        "command": "loragent.sync",
        "title": "Loragent: Synchronize All 224 Agent Skills",
        "category": "Loragent"
      },
      {
        "command": "loragent.titiVault",
        "title": "Loragent: TiTi Vault Enclave Status",
        "category": "Loragent"
      }
    ]
  },
  "scripts": {
    "start": "node ./face/cli/index.js",
    "build": "node scripts/build-website-data.js",
    "sync-rules": "node scripts/universal-sync.js",
    "sync": "node scripts/universal-sync.js",
    "postinstall": "npm run sync",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "deploy:all": "node scripts/deploy-all.js",
    "package:vsix": "vsce package --no-dependencies",
    "test": "node --test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15.0.0"
  },
  "type": "module"
}
